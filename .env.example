# Kaizen — required environment variables.
# Copy to .env and fill in real values. .env is gitignored.

# ─── Lightning AI ────────────────────────────────────────────────────
# Get from https://lightning.ai → user menu → API keys.
# Owner action: keys shared over chat should be rotated after this setup.
LIGHTNING_USER_ID=
LIGHTNING_API_KEY=

# Teamspace routing for CLI/SDK. Currently under Kairos 777 Inc org;
# revisit if we move training under Kaizen LLC parent.
LIGHTNING_ORG=kairos-777-inc
LIGHTNING_TEAMSPACE=default-project

# ─── LLM provider (NVIDIA NIM by default) ────────────────────────────
# NIM has DeepSeek + Llama + IBM Granite; NO Qwen as of 2026-08-28.
# The default model matches what the Kairos backend uses in prod so
# Kaizen inherits the same behavior. Swap to a smaller / faster model
# for autonomous ticking to keep credit burn low.
# KAIZEN_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# KAIZEN_LLM_MODEL=deepseek-ai/deepseek-v4-pro-0813
# KAIZEN_LLM_API_KEY=nvapi-...
# KAIZEN_LLM_TIMEOUT_MS=180000
# KAIZEN_LLM_MAX_TOKENS=768
# KAIZEN_LLM_TEMPERATURE=0.2

# ─── Hugging Face (adapter storage) ──────────────────────────────────
# Only needed when pushing checkpoints. Read-only when pulling public models.
# HF_TOKEN=

# ─── Weights & Biases (optional; training telemetry) ─────────────────
# WANDB_API_KEY=
# WANDB_PROJECT=kaizen-training
