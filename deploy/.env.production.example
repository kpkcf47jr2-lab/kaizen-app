# /etc/kaizen-app.env — production env for kaizen-app.service
# NEVER commit real values. chmod 0640 root:kaizen.

# ─── Bind ─────────────────────────────────────────────────────────
KAIZEN_HOST=0.0.0.0
KAIZEN_PORT=4711
KAIZEN_SCHEDULER_POLL_SEC=30
KAIZEN_SCHEDULER_CONCURRENCY=3

# ─── State dir (persistent — mount an encrypted volume in prod) ──
KAIZEN_STATE_DIR=/opt/kaizen-app/data

# ─── Vault passphrase (≥16 chars) ────────────────────────────────
# Rotate on any suspicion of exposure. Every agent's mnemonic is
# encrypted with this. Backup / escrow separately from the app.
KAIZEN_VAULT_PASSPHRASE=CHANGE_ME_TO_A_LONG_RANDOM_STRING_32_CHARS

# ─── LLM ─────────────────────────────────────────────────────────
KAIZEN_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
KAIZEN_LLM_MODEL=deepseek-ai/deepseek-v4-flash-0731
KAIZEN_LLM_API_KEY=nvapi-CHANGE_ME
KAIZEN_LLM_TIMEOUT_MS=120000
KAIZEN_LLM_MAX_TOKENS=768
KAIZEN_LLM_TEMPERATURE=0.2

# ─── Chain RPCs (Polygon 137 + Base 8453) ────────────────────────
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
# Owner may swap for Alchemy/Ankr key when rate limits bite.

KAIZEN_ETH_USD_RATE=3200
KAIZEN_POL_USD_RATE=0.5

# ─── Kairos ecosystem endpoints ──────────────────────────────────
KAIROS_ROUTER_BASE=https://api.kairos777.com/api/router
KAIROS_PREDICT_BASE=https://api.kairos777.com/api/predict
KAIROS_KAME_BASE=https://api.kairos777.com/api/kame
KAIROS_KAME_API_KEY=

# ─── Commerce (optional — features degrade gracefully if unset) ──
KAIZEN_AMAZON_PARTNER_TAG=
KAIZEN_AMAZON_API_KEY=
KAIZEN_BING_SEARCH_KEY=

# ─── Social (optional) ───────────────────────────────────────────
# Kaizen never impersonates humans. Post handles must be Kaizen-branded.
KAIZEN_TWITTER_BEARER=
KAIZEN_TELEGRAM_BOT_TOKEN=
KAIZEN_TELEGRAM_DEFAULT_CHAT=
